# =====================================================================
#  CONFIGURAÇÃO — copie este arquivo para ".env" e preencha.
#  (o arquivo .env tem senhas: NUNCA envie para o GitHub)
# =====================================================================

# ---- Clínica ---------------------------------------------------------
NOME_CLINICA=Clínica-Escola de Odontologia
FUSO_HORARIO=America/Sao_Paulo
# Período do semestre em que a clínica atende (ano-mês-dia)
SEMESTRE_INICIO=2026-08-03
SEMESTRE_FIM=2026-12-11
# Agendar com pelo menos N dias de antecedência
DIAS_ANTECEDENCIA_MIN=1
MAX_HORARIOS_OFERECIDOS=5

# ---- Banco de dados --------------------------------------------------
# Troque por uma senha forte
POSTGRES_PASSWORD=troque-esta-senha-do-banco

# ---- WhatsApp Cloud API (Meta for Developers > seu app > WhatsApp) ----
# Token de acesso (o temporário dura 24h; em produção use um token de "usuário do sistema")
WHATSAPP_TOKEN=
# "Identificação do número de telefone" (Phone number ID)
WHATSAPP_PHONE_NUMBER_ID=
# Uma senha que VOCÊ inventa e repete na tela de configuração do webhook da Meta
WHATSAPP_VERIFY_TOKEN=invente-um-token-de-verificacao
# Configurações do app > Básico > "Chave secreta do aplicativo" (App Secret)
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v23.0
# Nome do modelo (template) de lembrete aprovado na Meta
TEMPLATE_LEMBRETE=lembrete_consulta
TEMPLATE_IDIOMA=pt_BR
# Opcional: template avisando o paciente quando a RECEPÇÃO agenda (deixe vazio para não usar)
TEMPLATE_AGENDAMENTO=
# Opcional: template para o ATENDENTE iniciar conversa depois de 24h sem mensagem do paciente
#   ex.: "Olá {{1}}! Aqui é da Clínica-Escola de Odontologia. Podemos falar sobre seu atendimento?"
TEMPLATE_CONTATO=

# ---- Rotinas automáticas ---------------------------------------------
LEMBRETE_HORAS_ANTES=24
RECUPERACAO_APOS_HORAS=2
INTERVALO_TAREFAS_MIN=10

# ---- Chatwoot (OPCIONAL — o sistema já tem caixa de atendimento própria) ----
# Gere com:  openssl rand -hex 64
CHATWOOT_SECRET_KEY_BASE=troque-por-um-texto-aleatorio-bem-grande
CHATWOOT_FRONTEND_URL=http://localhost:3000
# Preencha depois de criar a caixa "API" no Chatwoot (ver README, passo 4)
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_INBOX_ID=
CHATWOOT_WEBHOOK_TOKEN=invente-outro-token

# ---- Sistema da clínica (http://localhost:8000) ----------------------
# Usuários:  login:senha:papel  separados por vírgula
#   papel "recepcao"    -> agenda, pacientes, prontuário, lista de espera, indicadores
#   papel "coordenacao" -> tudo isso + configurar clínicas das turmas + ver registro de acessos
# Crie um login para CADA pessoa (o sistema registra quem fez o quê, exigência da LGPD).
USUARIOS=coordenacao:troque-esta-senha:coordenacao,recepcao:troque-esta-senha:recepcao
# Texto aleatório grande (protege o login). Gere com:  openssl rand -hex 32
CHAVE_SESSAO=troque-por-um-texto-aleatorio
TAMANHO_MAX_ARQUIVO_MB=20
